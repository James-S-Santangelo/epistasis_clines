// SLiM v5 simulation: 1D landscape with population size gradient,
// two unlinked chromosomes, six types of epistasis tracked simultaneously.
//
// Command-line parameters (pass with -d KEY=value):
//   MAX_MIG_RATE   migration rate between adjacent demes; default 0.01
//   REPLICATE      replicate ID (integer); default 1
//
// Migration model:
//   Nearest-neighbour only: each deme exchanges migrants only with its
//   immediate left/right neighbour at rate MAX_MIG_RATE.
//
// Output:
//   One TSV file per replicate written to OUT_DIR/
//   Filename: sim_mig{MAX_MIG_RATE}_rep{REPLICATE}.tsv
//   First row written at generation 1 (initial state after seeding).

initialize() {
    // -------------------------------------------------------------------------
    // Command-line overridable parameters
    // Pass with e.g.: slim -d MAX_MIG_RATE=0.05 -d REPLICATE=42 -d OUT_DIR='"results"'
    // -------------------------------------------------------------------------
    if (!exists("MAX_MIG_RATE")) defineConstant("MAX_MIG_RATE", 0.01);
    if (!exists("REPLICATE"))    defineConstant("REPLICATE",    1);
    if (!exists("OUT_FILE"))     defineConstant("OUT_FILE", "./sim_mig" + MAX_MIG_RATE + "_rep" + REPLICATE + ".tsv");

    // -------------------------------------------------------------------------
    // Fixed parameters
    // -------------------------------------------------------------------------
    defineConstant("NUM_POPS",      40);
    defineConstant("POP_MAX",   10000);
    defineConstant("POP_MIN",      10);
    defineConstant("MU",         1e-8);
    defineConstant("RHO",        1e-9);
    defineConstant("CHROM_LEN",  10000);
    defineConstant("GENE_START",  4500);
    defineConstant("GENE_END",    5500);
    defineConstant("FOCAL_POS",   5000);
    defineConstant("T_END",      5000);
    defineConstant("OUT_FREQ",     50);

    // -------------------------------------------------------------------------
    // Mutation types
    // -------------------------------------------------------------------------
    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.convertToSubstitution = T;

    initializeMutationType("m2", 1.0, "f", 0.0);   // dominant allele, locus A
    m2.convertToSubstitution = F;

    initializeMutationType("m3", 1.0, "f", 0.0);   // dominant allele, locus B
    m3.convertToSubstitution = F;

    // -------------------------------------------------------------------------
    // Genomic element types
    // -------------------------------------------------------------------------
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElementType("g2", m1, 1.0);

    // -------------------------------------------------------------------------
    // Chromosome 1 — locus A
    // -------------------------------------------------------------------------
    initializeChromosome(1, CHROM_LEN);
    initializeGenomicElement(g1, 0,          GENE_START - 1);
    initializeGenomicElement(g2, GENE_START, GENE_END);
    initializeGenomicElement(g1, GENE_END+1, CHROM_LEN - 1);
    initializeMutationRate(MU);
    initializeRecombinationRate(RHO);

    // -------------------------------------------------------------------------
    // Chromosome 2 — locus B
    // -------------------------------------------------------------------------
    initializeChromosome(2, CHROM_LEN);
    initializeGenomicElement(g1, 0,          GENE_START - 1);
    initializeGenomicElement(g2, GENE_START, GENE_END);
    initializeGenomicElement(g1, GENE_END+1, CHROM_LEN - 1);
    initializeMutationRate(MU);
    initializeRecombinationRate(RHO);

}

// =============================================================================
// OUTPUT FUNCTION — called explicitly from 1 late() and the recurring late()
// =============================================================================
function (void) writeOutput(void) {
    for (pop in sim.subpopulations) {
        n = pop.individualCount;
        if (n == 0) next;

        // Counters, named generically. pheno1 = first class in the conventional
        // F2 ratio for each interaction type (see comments below).
        re1 = 0;  re2 = 0;  re3 = 0;    // Recessive epistasis    (9:3:4)
        de1 = 0;  de2 = 0;  de3 = 0;    // Dominant epistasis     (12:3:1)
        di1 = 0;  di2 = 0;              // Dominant inhibitory    (13:3)
        dre1 = 0; dre2 = 0;             // Duplicate recessive    (9:7)
        dde1 = 0; dde2 = 0;             // Duplicate dominant     (15:1)
        po1 = 0;  po2 = 0;  po3 = 0;    // Polymeric              (9:6:1)

        // Control A: dihybrid, NO epistasis (9:3:3:1) — four distinct classes.
        // Same complete-dominance machinery as the six types, but each genotype
        // class maps to its own phenotype (no inter-locus interaction).
        ne1 = 0;  ne2 = 0;  ne3 = 0;  ne4 = 0;   // A_B_ : A_bb : aaB_ : aabb

        // Control B: strictly additive dosage (no dominance, no epistasis).
        // Phenotype value = number of counted alleles across both loci (0..4).
        // Reported as the frequency of each dosage class. Note: the population
        // MEAN of this trait is exactly 2*(freq_domA + freq_domB), so it is a
        // linear function of the allele frequencies already output; the class
        // distribution below is what carries extra (HWE/LD-departure) info.
        add0 = 0; add1 = 0; add2 = 0; add3 = 0; add4 = 0;

        countA = 0;     countB = 0;

        for (ind in pop.individuals) {
            // Per-locus dosage (0, 1, or 2 copies of the counted allele)
            dosageA = asInteger(sum(ind.haplosomes[0].mutations.mutationType == m2) > 0) +
                      asInteger(sum(ind.haplosomes[1].mutations.mutationType == m2) > 0);
            dosageB = asInteger(sum(ind.haplosomes[2].mutations.mutationType == m3) > 0) +
                      asInteger(sum(ind.haplosomes[3].mutations.mutationType == m3) > 0);

            domA = (dosageA > 0);
            domB = (dosageB > 0);

            countA = countA + dosageA;
            countB = countB + dosageB;

            // 1. Recessive Epistasis (9:3:4)
            //    pheno1 = A_B_ (9), pheno2 = A_bb (3), pheno3 = aa__ (4)
            if (domA & domB)        re1 = re1 + 1;
            else if (domA & !domB)  re2 = re2 + 1;
            else                    re3 = re3 + 1;

            // 2. Dominant Epistasis (12:3:1)
            //    pheno1 = A___ (12), pheno2 = aaB_ (3), pheno3 = aabb (1)
            if (domA)               de1 = de1 + 1;
            else if (domB)          de2 = de2 + 1;
            else                    de3 = de3 + 1;

            // 3. Dominant Inhibitory Epistasis (13:3)
            //    pheno1 = rest (13), pheno2 = aaB_ (3)
            if (!domA & domB)       di2 = di2 + 1;
            else                    di1 = di1 + 1;

            // 4. Duplicate Recessive Epistasis (9:7)
            //    pheno1 = A_B_ (9), pheno2 = rest (7)
            if (domA & domB)        dre1 = dre1 + 1;
            else                    dre2 = dre2 + 1;

            // 5. Duplicate Dominant Epistasis (15:1)
            //    pheno1 = any dominant (15), pheno2 = aabb (1)
            if (domA | domB)        dde1 = dde1 + 1;
            else                    dde2 = dde2 + 1;

            // 6. Polymeric Gene Interaction (9:6:1)
            //    pheno1 = A_B_ (9), pheno2 = one dominant (6), pheno3 = aabb (1)
            if (domA & domB)        po1 = po1 + 1;
            else if (domA | domB)   po2 = po2 + 1;
            else                    po3 = po3 + 1;

            // Control A. No epistasis (9:3:3:1): four distinct classes
            //    pheno1 = A_B_ (9), pheno2 = A_bb (3), pheno3 = aaB_ (3), pheno4 = aabb (1)
            if (domA & domB)        ne1 = ne1 + 1;
            else if (domA & !domB)  ne2 = ne2 + 1;
            else if (!domA & domB)  ne3 = ne3 + 1;
            else                    ne4 = ne4 + 1;

            // Control B. Additive dosage (0..4): bin by total counted alleles
            dos = dosageA + dosageB;
            if      (dos == 0) add0 = add0 + 1;
            else if (dos == 1) add1 = add1 + 1;
            else if (dos == 2) add2 = add2 + 1;
            else if (dos == 3) add3 = add3 + 1;
            else               add4 = add4 + 1;
        }

        line = sim.cycle + "\t" + pop.id + "\t" + n + "\t" +
               MAX_MIG_RATE + "\t" + REPLICATE + "\t" + POP_MAX + "\t" + POP_MIN + "\t" +
               (countA / (2.0 * n)) + "\t" + (countB / (2.0 * n)) + "\t" +
               (re1 / n)  + "\t" + (re2 / n)  + "\t" + (re3 / n)  + "\t" +
               (de1 / n)  + "\t" + (de2 / n)  + "\t" + (de3 / n)  + "\t" +
               (di1 / n)  + "\t" + (di2 / n)  + "\t" +
               (dre1 / n) + "\t" + (dre2 / n) + "\t" +
               (dde1 / n) + "\t" + (dde2 / n) + "\t" +
               (po1 / n)  + "\t" + (po2 / n)  + "\t" + (po3 / n)  + "\t" +
               (ne1 / n)  + "\t" + (ne2 / n)  + "\t" + (ne3 / n)  + "\t" + (ne4 / n)  + "\t" +
               (add0 / n) + "\t" + (add1 / n) + "\t" + (add2 / n) + "\t" +
               (add3 / n) + "\t" + (add4 / n);

        writeFile(OUT_FILE, line, append=T);
    }
}

// =============================================================================
// 1  BUILD SUBPOPULATIONS
// =============================================================================
1 early() {
    // Demography must be established in early() so offspring generation in
    // generation 1 already uses the correct population structure.
    logMax = log10(POP_MAX);
    logMin = log10(POP_MIN);

    for (i in 1:NUM_POPS) {
        frac = (i - 1.0) / (NUM_POPS - 1.0);
        sz = asInteger(round(10^(logMax - frac * (logMax - logMin))));
        sim.addSubpop("p" + i, sz);
    }

    // Nearest-neighbour migration only.
    // Interior demes have two neighbours so total emigration = 2 * MAX_MIG_RATE;
    // keep MAX_MIG_RATE <= 0.5.
    if (MAX_MIG_RATE > 0.0) {
        for (i in 1:NUM_POPS) {
            src = sim.subpopulations[sim.subpopulations.id == i];
            if (i > 1) {
                left = sim.subpopulations[sim.subpopulations.id == (i - 1)];
                src.setMigrationRates(left, MAX_MIG_RATE);
            }
            if (i < NUM_POPS) {
                right = sim.subpopulations[sim.subpopulations.id == (i + 1)];
                src.setMigrationRates(right, MAX_MIG_RATE);
            }
        }
    }
}

1 late() {
    // Seed dominant alleles at frequency 0.5 in all populations.
    // Done in late() so mutations are present in the individuals that will
    // act as parents from generation 2 onward (avoids the WF early() warning).
    for (pop in sim.subpopulations) {
        for (ind in pop.individuals) {
            ind.haplosomes[0].addNewMutation(m2, 0.0, FOCAL_POS);
            ind.haplosomes[2].addNewMutation(m3, 0.0, FOCAL_POS);
        }
    }

    // Write header then immediately output generation 1 as the baseline
    header = "generation\tpop_id\tpop_size\tmax_mig_rate\treplicate\tpop_max\tpop_min\t" +
             "freq_domA\tfreq_domB\t" +
             "RE_pheno1\tRE_pheno2\tRE_pheno3\t" +
             "DE_pheno1\tDE_pheno2\tDE_pheno3\t" +
             "DI_pheno1\tDI_pheno2\t" +
             "DRE_pheno1\tDRE_pheno2\t" +
             "DDE_pheno1\tDDE_pheno2\t" +
             "PO_pheno1\tPO_pheno2\tPO_pheno3\t" +
             "NE_pheno1\tNE_pheno2\tNE_pheno3\tNE_pheno4\t" +
             "ADD_d0\tADD_d1\tADD_d2\tADD_d3\tADD_d4";
    writeFile(OUT_FILE, header, append=F);
    writeOutput();   // baseline snapshot at generation 1
}

// =============================================================================
// 2  PHENOTYPE TRACKING — every OUT_FREQ generations
// =============================================================================
late() {
    if (sim.cycle % OUT_FREQ != 0) return;
    writeOutput();
}

// =============================================================================
// 3  END
// =============================================================================
T_END late() {
    catn("Simulation complete: mig=" + MAX_MIG_RATE + " rep=" + REPLICATE);
    sim.simulationFinished();
}
